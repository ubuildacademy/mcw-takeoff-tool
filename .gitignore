# nyc test coverage
.nyc_output

# Playwright test artifacts
playwright-report/
test-results/

# Uploads and test files
server/uploads/
server/data/*.json
!server/data/conditions.json
!server/data/projects.json
!server/data/files.json

# Temporary files
*.tmp
*.temp
temp/
.vercel

# Large model files (use Git LFS or external storage)
server/models/*.pth
server/models/*.pt
server/models/*.ckpt

# Local training datasets and large assets (kept out of git history)
Cubicasa5k/
server/data/

# Python virtual environment
server/venv/
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Claude Code local settings (machine-specific permissions)
.claude/settings.local.json

# Git worktrees created by tooling
.claude/worktrees/

# iCloud Drive sync conflicts. This repo lives under ~/Library/Mobile Documents,
# where a conflicted copy is saved as "name 2.ts" alongside the original. One of
# those was committed on 2026-08-21 and broke the Railway build: " 2.ts" does not
# match the "**/*.test.ts" exclude in server/tsconfig.json, so tsc compiled a test
# file and failed on its vitest import, which is absent from a production install.
# Use `git add -f` if a file legitimately ends in a space and a digit.
* [0-9].*
